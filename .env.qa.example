# ==============================================================================
# CONFIGURACIÓN DE ENTORNO QA (COOLIFY) - nexo-pro.com.co
# ==============================================================================

APP_NAME="NEXO PRO (QA)"
APP_ENV=staging
APP_KEY=base64:GENERA_TU_PROPIA_KEY_CON_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://qa.nexo-pro.com.co

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── BASE DE DATOS POSTGRESQL (Contenedor QA) ─────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=nexopro_qa
DB_USERNAME=nexopro_qa_user
DB_PASSWORD=SuperSecretQaPass2026!
DB_SCHEMA=public,iam,property,operations,finance,asamblea

# ── DRIVERS DE ALTO RENDIMIENTO (Redis) ──────────────────────────────
BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── WEBSOCKETS LARAVEL REVERB ────────────────────────────────────────
REVERB_APP_ID=nexopro_qa_appid
REVERB_APP_KEY=nexopro_qa_key
REVERB_APP_SECRET=nexopro_qa_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="qa.nexo-pro.com.co"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME="https"

# ── CONFIGURACIÓN DE CORREO (Mailpit o SMTP) ─────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@nexo-pro.com.co"
MAIL_FROM_NAME="${APP_NAME}"

# ── SERVICIOS EXTERNOS (WOMPI / LIVEKIT) ─────────────────────────────
WOMPI_PUBLIC_KEY=pub_test_wompi_sample_key
WOMPI_PRIVATE_KEY=prv_test_wompi_sample_key
WOMPI_INTEGRITY_KEY=test_integrity_sample_key
WOMPI_ENV=sandbox

LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── AUTOMATIZACIÓN ENTRYPOINT DOCKER ─────────────────────────────────
RUN_MIGRATIONS=true
RUN_SEEDERS=true
